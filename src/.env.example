# === TRADING BOT — CONFIGURATION ===
# Copie ce fichier en ".env" (dans le meme dossier) et remplis tes valeurs.
# Le fichier .env n'est JAMAIS commite (voir .gitignore).

# ─────────────────────────────────────────────────────────────────────────────
#  MODE DE TRADING
# ─────────────────────────────────────────────────────────────────────────────
# true  = PAPER  : simulation, aucun ordre reel. Commence toujours par la.
# false = LIVE   : ordres reels avec ton argent.
PAPER_TRADING=true

# Capital de depart en mode PAPER, en EUR. Mets-y le montant que tu engagerais
# reellement : la simulation n'a d'interet que si elle reflete ton vrai compte.
# En mode LIVE, cette valeur est ignoree (le solde Binance fait foi).
INITIAL_CAPITAL=1000

# ─────────────────────────────────────────────────────────────────────────────
#  ACCES AU DASHBOARD  (obligatoire des que le dashboard sort de la machine)
# ─────────────────────────────────────────────────────────────────────────────
# Mot de passe d'acces. 16 caracteres aleatoires minimum.
# Sans lui, le bot refuse d'ecouter ailleurs que sur 127.0.0.1.
DASHBOARD_PASSWORD=

# Interface d'ecoute :
#   127.0.0.1 = machine locale uniquement (valeur sure par defaut)
#   0.0.0.0   = joignable depuis le reseau / le tunnel
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# A passer a true UNIQUEMENT si un tunnel ou un reverse proxy est devant
# (Cloudflare Tunnel, Caddy, nginx). Active les cookies HTTPS-only et la lecture
# de la vraie IP client.
TRUST_PROXY=false

# Duree de validite d'une session ouverte, en jours.
SESSION_DAYS=30

# Cle de signature des sessions. Laisse vide : generee automatiquement et
# conservee dans data/secret_key.
FLASK_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
#  BINANCE   https://www.binance.com/fr/my/settings/api-management
# ─────────────────────────────────────────────────────────────────────────────
# Sur la cle API : autorise "Lecture" + "Spot Trading".
# N'autorise JAMAIS les retraits. Restreins la cle a l'IP de la machine.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
#  IA  (optionnel — le bot fonctionne sans, avec une analyse degradee)
# ─────────────────────────────────────────────────────────────────────────────
# Groq : gratuit, 14400 requetes/jour — https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic : payant, utilise en repli si Groq est indisponible
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
#  TELEGRAM  (optionnel — alertes et commandes /status /pause /resume)
# ─────────────────────────────────────────────────────────────────────────────
# Cree le bot avec https://t.me/BotFather  ->  /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────────────────────
#  ACTIONS A DISTANCE  (desactivees par defaut)
# ─────────────────────────────────────────────────────────────────────────────
# Bouton "Mise a jour" du dashboard : git pull + redemarrage du bot.
# Executer du code recupere sur le reseau depuis une page web est risque si le
# mot de passe fuit — laisse false sauf besoin explicite.
ALLOW_REMOTE_UPDATE=false

# Bouton "Entrainer le modele" du dashboard (consomme du CPU pendant ~10 min).
ALLOW_REMOTE_TRAIN=true

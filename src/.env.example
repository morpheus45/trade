# === TRADING BOT — CONFIGURATION ===
# Copie ce fichier en ".env" (dans le meme dossier) et remplis tes valeurs.
# Le fichier .env n'est JAMAIS commite (voir .gitignore).

# ─────────────────────────────────────────────────────────────────────────────
#  MODE DE TRADING
# ─────────────────────────────────────────────────────────────────────────────
# true  = PAPER  : simulation, aucun ordre reel. Commence toujours par la.
# false = LIVE   : ordres reels avec ton argent.
PAPER_TRADING=true

# Capital de depart en mode PAPER, en EUR. Mets-y le montant que tu engagerais
# reellement : la simulation n'a d'interet que si elle reflete ton vrai compte.
# En mode LIVE, cette valeur est ignoree (le solde Binance fait foi).
INITIAL_CAPITAL=1000

# ─────────────────────────────────────────────────────────────────────────────
#  ACCES AU DASHBOARD  (obligatoire des que le dashboard sort de la machine)
# ─────────────────────────────────────────────────────────────────────────────
# Mot de passe d'acces. 16 caracteres aleatoires minimum.
# Sans lui, le bot refuse d'ecouter ailleurs que sur 127.0.0.1.
DASHBOARD_PASSWORD=

# Interface d'ecoute :
#   127.0.0.1 = machine locale uniquement (valeur sure par defaut)
#   0.0.0.0   = joignable depuis le reseau / le tunnel
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# A passer a true UNIQUEMENT si un tunnel ou un reverse proxy est devant
# (Cloudflare Tunnel, Caddy, nginx). Active les cookies HTTPS-only et la lecture
# de la vraie IP client.
TRUST_PROXY=false

# Duree de validite d'une session ouverte, en jours.
SESSION_DAYS=30

# Cle de signature des sessions. Laisse vide : generee automatiquement et
# conservee dans data/secret_key.
FLASK_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
#  BINANCE   https://www.binance.com/fr/my/settings/api-management
# ─────────────────────────────────────────────────────────────────────────────
# Sur la cle API : autorise "Lecture" + "Spot Trading".
# N'autorise JAMAIS les retraits. Restreins la cle a l'IP de la machine.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
#  IA  (optionnel — le bot fonctionne sans, avec une analyse degradee)
# ─────────────────────────────────────────────────────────────────────────────
# Groq : gratuit, 14400 requetes/jour — https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic : payant, utilise en repli si Groq est indisponible
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
#  JEV / TypeSafe AI  (optionnel — couche de decision typee)
# ─────────────────────────────────────────────────────────────────────────────
# Jev repond a des questions typees par des valeurs structurees avec des
# probabilites calibrees, en ~120 ms, au lieu d'un texte a reparser.
# Cle : https://console.typesafe.ai   Doc : https://docs.typesafe.ai
TYPESAFE_API_KEY=

# Mode de fonctionnement :
#   off      Jev n'est pas appele.
#   shadow   Jev est interroge et journalise dans logs/jev_decisions.jsonl,
#            mais NE CHANGE AUCUNE DECISION. Valeur par defaut : laisse tourner
#            plusieurs jours pour comparer ses avis aux trades reellement pris,
#            avant de lui donner le moindre pouvoir.
#   filter   Jev s'ajoute au pipeline comme veto supplementaire.
#   primary  Jev decide seul ; le LLM n'est plus appele (gain de latence).
JEV_MODE=shadow

# Si Jev est injoignable :
#   fallback  repli sur le pipeline habituel (comportement du bot sans Jev)
#   skip      aucun trade (echec ferme, plus prudent)
JEV_ON_ERROR=fallback

# ── Fiabilite ────────────────────────────────────────────────────────────────
# Jev n'est pas deterministe : TypeSafe mesure qu'il rejoue son label
# majoritaire ~90,8 % du temps sur un cas limite. Les reglages ci-dessous
# appliquent le correctif qu'ils documentent : ne pas agir sur une reponse dont
# la masse de probabilite est trop diffuse pour etre stable.

# Probabilite minimale de l'option retenue. A 0,60, TypeSafe mesure 99,2 %
# d'accord entre executions, au prix d'environ un quart de reponses ecartees.
# JEV_MIN_TOP_PROBABILITY=0.60

# Un Noul ne porte pas de confiance : c'est sa valeur qui exprime l'incertitude.
# Entre ces deux bornes, la reponse ne dit ni oui ni non et ne declenche rien.
# JEV_NOUL_UNCERTAIN_LOW=0.30
# JEV_NOUL_UNCERTAIN_HIGH=0.70

# Nombre de questions pouvant rester incertaines (sur 8) sans invalider
# l'evaluation. Au-dela, l'etat ne permet pas de trancher : abstention.
# JEV_MAX_UNCERTAIN=3

# Nombre de tirages par decision. 1 = un appel. Au-dela, l'accord unanime est
# exige : des tirages divergents valent abstention. Mettre 3 avant de passer en
# argent reel — le cout reste negligeable, la latence monte a ~0,4 s.
# JEV_CONSENSUS_SAMPLES=1

# ── Seuils de decision ───────────────────────────────────────────────────────
# JEV_MIN_CONFIDENCE=0.65      # confiance minimale sur les Score
# JEV_MIN_QUALITY=2.0          # qualite minimale du setup, sur une echelle 0..4
# JEV_VETO_THRESHOLD=0.70      # seuil des vetos (sur-extension, risque, alignement)
# JEV_TIMEOUT_SECONDS=8        # un appel qui traine coute plus qu'un appel qui echoue

# Modulation de la taille de position par la qualite du setup.
# JEV_SIZE_MIN=0.60
# JEV_SIZE_MAX=1.40

# ─────────────────────────────────────────────────────────────────────────────
#  TELEGRAM  (optionnel — alertes et commandes /status /pause /resume)
# ─────────────────────────────────────────────────────────────────────────────
# Cree le bot avec https://t.me/BotFather  ->  /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────────────────────
#  ACTIONS A DISTANCE  (desactivees par defaut)
# ─────────────────────────────────────────────────────────────────────────────
# Bouton "Mise a jour" du dashboard : git pull + redemarrage du bot.
# Executer du code recupere sur le reseau depuis une page web est risque si le
# mot de passe fuit — laisse false sauf besoin explicite.
ALLOW_REMOTE_UPDATE=false

# Bouton "Entrainer le modele" du dashboard (consomme du CPU pendant ~10 min).
ALLOW_REMOTE_TRAIN=true
